root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = off
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
ij_kotlin_continuation_indent_size = 4
ij_kotlin_keep_line_breaks = true
ij_kotlin_assignment_wrap = normal
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, ^
ij_kotlin_method_call_chain_wrap = normal
ij_kotlin_wrap_first_method_in_call_chain = false
ij_kotlin_method_parameters_wrap = split_into_lines
ij_kotlin_method_parameters_new_line_after_left_paren = true
ij_kotlin_method_parameters_right_paren_on_new_line = true
ij_kotlin_call_parameters_wrap = normal
ij_kotlin_call_parameters_new_line_after_left_paren = false
ij_kotlin_call_parameters_right_paren_on_new_line = false
ktlint_standard_indent = disabled
ktlint_standard_string-template-indent = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_function_signature_body_expression_wrapping = default
ktlint_standard_no-line-break-before-assignment = enabled
ktlint_standard_binary-expression-wrapping = enabled
ktlint_standard_annotation = disabled

[*.md]
trim_trailing_whitespace = false
ij_formatter_enabled = false

[*.{yml,yaml}]
indent_size = 2

[*.properties]
ij_formatter_enabled = false

[*.json]
indent_size = 2

[tools/npm-generator/src/main/kotlin/**.kt]
ij_formatter_enabled = false

[buildSrc/src/main/kotlin/GenerateLocalizationTask.kt]
ij_formatter_enabled = false