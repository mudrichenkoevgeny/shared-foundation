rootProject.name = "{{PROJECT_REPO_NAME}}"

fun registerModules(
    group: String,
    modules: List<String>
) {
    modules.forEach { name ->
        val gradlePath = ":$group:$name"
        val folderPath = "$group/$name"
        include(gradlePath)
        project(gradlePath).projectDir = file(folderPath)
    }
}

include(":core")

registerModules(
    "tools",
    listOf("npm-generator-runner")
)

